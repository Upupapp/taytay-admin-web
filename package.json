{
  "name": "taytay-social-welfare",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run check:brand && npm run check:shell && npm run check:access && npm run check:vulnerability && npm run check:case-audit && npm run check:intake && npm run check:programs && npm test && npm run build",
    "check:brand": "node tools/check-brand-assets.mjs",
    "check:shell": "node tools/check-shell-a11y.mjs",
    "check:access": "node tools/check-access.mjs",
    "check:vulnerability": "node tools/check-vulnerability.mjs",
    "check:case-audit": "node tools/check-case-audit.mjs",
    "check:intake": "node tools/check-intake.mjs",
    "check:programs": "node tools/check-programs.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
