{
  "name": "taytay-social-welfare",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run check:constitution && npm run check:environments && npm run check:headers && npm run check:deps && npm run check:contract && npm run check:contract-drift && npm run check:routes && npm run check:wire-adoption && npm run check:port-adoption && npm run check:consumer-contract && npm run check:mapper-adoption && npm run check:permission-parity && npm run check:auth && npm run check:brand && npm run check:shell && npm run check:access && npm run check:vulnerability && npm run check:case-audit && npm run check:intake && npm run check:programs && npm run check:beneficiary && npm run check:documents && npm run check:documents-transport && npm run check:referrals && npm run check:visits && npm run check:releases && npm run check:money && npm run check:work && npm run check:reports && npm run check:search && npm run check:governance && npm run check:hardening && npm run check:contrast && npm run check:community && npm run check:newsfeed && npm run check:events && npm test && npm run build && npm run check:bundle",
    "check:constitution": "node tools/check-constitution.mjs",
    "check:brand": "node tools/check-brand-assets.mjs",
    "check:shell": "node tools/check-shell-a11y.mjs",
    "check:access": "node tools/check-access.mjs",
    "check:vulnerability": "node tools/check-vulnerability.mjs",
    "check:case-audit": "node tools/check-case-audit.mjs",
    "check:intake": "node tools/check-intake.mjs",
    "check:programs": "node tools/check-programs.mjs",
    "check:beneficiary": "node tools/check-beneficiary.mjs",
    "check:documents": "node tools/check-documents.mjs",
    "check:referrals": "node tools/check-referrals.mjs",
    "check:visits": "node tools/check-visits.mjs",
    "check:releases": "node tools/check-releases.mjs",
    "check:work": "node tools/check-work.mjs",
    "check:reports": "node tools/check-reports.mjs",
    "check:search": "node tools/check-search.mjs",
    "check:governance": "node tools/check-governance.mjs",
    "check:hardening": "node tools/check-hardening.mjs",
    "check:community": "node tools/check-community.mjs",
    "check:newsfeed": "node tools/check-newsfeed.mjs",
    "check:events": "node tools/check-events.mjs",
    "check:contract": "node tools/check-contract.mjs",
    "check:auth": "node tools/check-auth.mjs",
    "check:contract-drift": "node tools/check-vendored-contract.mjs",
    "contract:emit": "node tools/emit-consumer-expectations.mjs",
    "check:consumer-contract": "node tools/emit-consumer-expectations.mjs --check",
    "check:mapper-adoption": "node tools/check-mapper-adoption.mjs",
    "check:permission-parity": "node tools/check-permission-parity.mjs",
    "check:money": "node tools/check-money.mjs",
    "check:documents-transport": "node tools/check-documents-transport.mjs",
    "check:environments": "node tools/check-environments.mjs",
    "check:bundle": "node tools/check-bundle.mjs",
    "check:headers": "node tools/check-headers.mjs",
    "check:deps": "npm audit --omit=dev --audit-level=high",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:routes": "node tools/check-routes.mjs",
    "check:wire-adoption": "node tools/check-wire-adoption.mjs",
    "check:port-adoption": "node tools/check-port-adoption.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
